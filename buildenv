# Auto-generated: custom test runner
# Uses package-native test command instead of pytest
zopen_custom_check() {
  . .venv/bin/activate
  pip install --disable-pip-version-check --no-warn-script-location --force-reinstall --no-deps dist/*.whl 2>/dev/null
    pip install --disable-pip-version-check --no-warn-script-location asgiref
    pip install --disable-pip-version-check --no-warn-script-location sqlparse
    pip install --disable-pip-version-check --no-warn-script-location tzdata
    pip install --disable-pip-version-check --no-warn-script-location tblib
  cd tests && python runtests.py --settings=test_sqlite --parallel=4 -v1
  zopen_check_result=$?
  deactivate
  return "${zopen_check_result}"
}

zopen_check_results() {
  dir="$1"; pfx="$2"; chk="$1/$2_check.log"
  totalTests=$(grep -oE "Ran [0-9]+ test" "${chk}" | tail -1 | grep -oE "[0-9]+")
  totalTests=${totalTests:-0}
  if grep -qE "^OK([[:space:]]*\(.*\))?[[:space:]]*$" "${chk}"; then
    actualFailures=0
  else
    fails=$(grep -oE "failures=[0-9]+" "${chk}" | tail -1 | cut -d= -f2)
    errs=$(grep -oE "errors=[0-9]+" "${chk}" | tail -1 | cut -d= -f2)
    fails=${fails:-0}
    errs=${errs:-0}
    actualFailures=$((fails + errs))
    if [ "${actualFailures}" -eq 0 ]; then
      actualFailures=1
    fi
  fi
  echo "actualFailures:${actualFailures}"
  echo "totalTests:${totalTests}"
  echo "expectedFailures:0"
}

export ZOPEN_CHECK="zopen_custom_check"
